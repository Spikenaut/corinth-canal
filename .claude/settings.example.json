{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": [
    "Starting point for a per-machine Claude Code config. This file is a",
    "template only and is not read by Claude Code. Copy it to",
    ".claude/settings.local.json (gitignored) and adjust to taste:",
    "",
    "    cp .claude/settings.example.json .claude/settings.local.json",
    "",
    "Only read-only, non-mutating commands are pre-approved here, so a cloud",
    "or web agent can investigate the repository without prompting while any",
    "action that writes, pushes, or publishes still asks."
  ],
  "permissions": {
    "allow": [
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(just --list)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch -a:*)",
      "Bash(git branch -vv:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git grep:*)",
      "Bash(git merge-base:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(bd prime)",
      "Bash(bd ready)",
      "Bash(bd show:*)",
      "Bash(bd list:*)",
      "mcp__github__pull_request_read"
    ]
  }
}
